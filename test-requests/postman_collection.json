    "name": "Segurança REST APIs (Estácio Presentation)",
    "description": "Coleção de testes para palestra sobre segurança de REST APIs: JWT, BOLA e BFLA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tokenAlice", "value": "" },
    { "key": "tokenJoao", "value": "" },
    { "key": "tokenMaria", "value": "" },
    { "key": "tokenAdmin", "value": "" }
  ],
  "item": [
    {
      "name": "0. Reset Banco de Dados",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reset",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reset"]
        }
      }
    },
    {
      "name": "1. Autenticação (Logins)",
      "item": [
        {
          "name": "1.1 Login Alice (Cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenAlice', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"123\",\n  \"version\": \"v1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
