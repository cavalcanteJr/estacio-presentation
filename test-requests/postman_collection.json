    {
      "name": "2. Demo BFLA (Quebra de Função)",
      "item": [
        {
          "name": "[ATAQUE V1] Alice acessa faturamento admin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/financials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "financials"]
            }
          }
        },
        {
          "name": "[ATAQUE V1] Alice cadastra produto no catálogo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PlayStation 5 Pro Hackeado\",\n  \"description\": \"Cadastrado por Alice explorando BFLA\",\n  \"price\": 3500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          }
        },
        {
          "name": "[DEFESA V2] Alice tenta faturamento (Bloqueado 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/admin/financials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "admin", "financials"]
            }
          }
        },
        {
          "name": "[DEFESA V2] Alice tenta cadastrar produto (Bloqueado 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tentativa Bloqueada\",\n  \"price\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Demo BOLA / IDOR (Guerra de Preços)",
      "item": [
        {
          "name": "Listar Produtos Atuais",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          }
        },
        {
          "name": "[ATAQUE V1] Maria altera preço do MacBook do João para R$ 1,00",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenMaria}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPrice\": 1.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "1", "price"]
            }
          }
        },
        {
          "name": "[DEFESA V2] Maria tenta alterar preço alheio (Bloqueado 403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenMaria}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPrice\": 0.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/products/1/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "products", "1", "price"]
            }
          }
        },
        {
          "name": "[DEFESA V2] João altera o próprio produto (Permitido 200)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenJoao}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPrice\": 13500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/products/1/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "products", "1", "price"]
            }
          }
        }
      ]
